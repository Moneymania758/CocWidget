<?xml version="1.0" encoding="utf-8"?>
<!-- A Timeline row filling up behind its text as the upgrade goes. The renderer tints the fill a
     faint shade of the theme's bar colour, so the row's text stays readable over it. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:id="@android:id/background">
        <shape>
            <corners android:radius="10dp" />
            <solid android:color="@android:color/transparent" />
        </shape>
    </item>
    <item android:id="@android:id/progress">
        <clip>
            <shape>
                <corners android:radius="10dp" />
                <solid android:color="@color/bar_top" />
            </shape>
        </clip>
    </item>
</layer-list>
