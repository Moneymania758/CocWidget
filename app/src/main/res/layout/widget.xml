<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:orientation="vertical"
    android:padding="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <!-- The frame takes what Import leaves. Inside it the title shrinks first, cut short with
             "…", so a long account name can't push Import or the TH label off. The switch arrow is
             the title's end drawable, so it stays when the name is cut. Lint calls the frame useless
             and the weight inefficient, but the frame is what lets the row inside stay only as wide
             as its text, and the weight on a wrap_content title is what makes the title the one
             that shrinks. -->
        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                tools:ignore="UselessParent">

                <TextView
                    android:id="@+id/title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    tools:ignore="InefficientWeight"
                    android:drawablePadding="4dp"
                    android:ellipsize="end"
                    android:fontFamily="sans-serif-black"
                    android:maxLines="1"
                    android:shadowColor="@color/text_shadow"
                    android:shadowDy="2"
                    android:shadowRadius="1"
                    android:text="@string/app_name"
                    android:textColor="@color/text"
                    android:textSize="18sp" />

                <TextView
                    android:id="@+id/town_hall"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:fontFamily="sans-serif-black"
                    android:maxLines="1"
                    android:shadowColor="@color/text_shadow"
                    android:shadowDy="2"
                    android:shadowRadius="1"
                    android:textColor="@color/gold"
                    android:textSize="14sp" />
            </LinearLayout>
        </FrameLayout>

        <TextView
            android:id="@+id/sync"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:background="@drawable/sync_button"
            android:drawableStart="@drawable/ic_import"
            android:drawablePadding="4dp"
            android:fontFamily="sans-serif-black"
            android:gravity="center_vertical"
            android:paddingStart="10dp"
            android:paddingTop="5dp"
            android:paddingEnd="12dp"
            android:paddingBottom="5dp"
            android:text="@string/import_short"
            android:textColor="#4A2E10"
            android:textSize="14sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/views"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:orientation="horizontal"
        android:visibility="gone">

        <TextView
            android:id="@+id/view_home"
            style="@style/WidgetViewButton"
            android:text="@string/view_home" />

        <TextView
            android:id="@+id/view_builder_base"
            style="@style/WidgetViewButton"
            android:layout_marginStart="6dp"
            android:text="@string/view_builder_base" />

        <TextView
            android:id="@+id/view_all"
            style="@style/WidgetViewButton"
            android:layout_marginStart="6dp"
            android:text="@string/view_all" />
    </LinearLayout>

    <TextView
        android:id="@+id/empty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="@string/empty_state"
        android:textColor="@color/text_dim"
        android:textSize="14sp" />

    <LinearLayout
        android:id="@+id/rows"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical" />

    <LinearLayout
        android:id="@+id/helpers"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:orientation="horizontal"
        android:visibility="gone">

        <Chronometer
            android:id="@+id/helpers_timer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/helper"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/helpers_ready"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-black"
            android:text="@string/helpers_ready"
            android:textColor="@color/helper"
            android:textSize="11sp"
            android:visibility="gone" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/update"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/text_dim"
            android:textSize="11sp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/all_upgrades"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:fontFamily="sans-serif-black"
            android:maxLines="1"
            android:paddingTop="2dp"
            android:paddingBottom="2dp"
            android:text="@string/widget_all_upgrades"
            android:textColor="@color/gold"
            android:textSize="12sp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/clear"
            style="@style/WidgetViewButton"
            android:layout_marginEnd="8dp"
            android:textColor="@color/gold"
            android:visibility="gone" />

        <TextView
            android:id="@+id/footer"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="end"
            android:textColor="@color/text_dim"
            android:textSize="11sp"
            android:visibility="gone" />
    </LinearLayout>
</LinearLayout>
