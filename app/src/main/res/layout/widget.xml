<?xml version="1.0" encoding="utf-8"?>
<!-- The big widget. One layout holds all three styles: Sections and Pages draw into "rows",
     Timeline into "hero" and "timeline_list". The renderer shows the parts its style needs. The
     list is the only scrolling view, and its rows hold no countdowns (see WidgetLayoutTest). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:orientation="vertical"
    android:padding="12dp">

    <LinearLayout
        android:id="@+id/header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <!-- The frame takes what Import and Open leave. Inside it the title shrinks first, cut short
             with "…", so a long account name can't push them off. The switch arrow is the title's
             end drawable, so it stays when the name is cut. Lint calls the frame useless and the
             weight inefficient, but the frame is what lets the row inside stay only as wide as its
             text, and the weight on a wrap_content title is what makes the title the one that
             shrinks. -->
        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                tools:ignore="UselessParent">

                <TextView
                    android:id="@+id/town_hall"
                    android:layout_width="34dp"
                    android:layout_height="34dp"
                    android:background="@drawable/wring_0"
                    android:fontFamily="sans-serif-black"
                    android:gravity="center"
                    android:maxLines="1"
                    android:textColor="@color/text"
                    android:textSize="11sp" />

                <TextView
                    android:id="@+id/title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    tools:ignore="InefficientWeight"
                    android:drawablePadding="4dp"
                    android:ellipsize="end"
                    android:fontFamily="sans-serif-black"
                    android:gravity="center_vertical"
                    android:maxLines="1"
                    android:minHeight="34dp"
                    android:text="@string/app_name"
                    android:textColor="@color/text"
                    android:textSize="16sp" />
            </LinearLayout>
        </FrameLayout>

        <TextView
            android:id="@+id/sync"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:background="@drawable/sync_button"
            android:drawableStart="@drawable/ic_import"
            android:drawablePadding="4dp"
            android:fontFamily="sans-serif-black"
            android:gravity="center_vertical"
            android:minHeight="34dp"
            android:paddingStart="10dp"
            android:paddingEnd="12dp"
            android:text="@string/import_short"
            android:textColor="#4A2E10"
            android:textSize="14sp" />

        <ImageView
            android:id="@+id/open"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:layout_marginStart="6dp"
            android:background="@drawable/chip_view"
            android:contentDescription="@string/widget_open_app"
            android:padding="8dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_open" />
    </LinearLayout>

    <!-- What is idle, at a glance. The renderer fills the chips it needs and hides the rest. -->
    <LinearLayout
        android:id="@+id/chips"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:orientation="horizontal"
        android:visibility="gone">

        <TextView
            android:id="@+id/chip_1"
            style="@style/WidgetChip" />

        <TextView
            android:id="@+id/chip_2"
            style="@style/WidgetChip"
            android:layout_marginStart="6dp" />

        <TextView
            android:id="@+id/chip_3"
            style="@style/WidgetChip"
            android:layout_marginStart="6dp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/views"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:orientation="horizontal"
        android:visibility="gone">

        <TextView
            android:id="@+id/view_home"
            style="@style/WidgetViewButton"
            android:text="@string/view_home" />

        <TextView
            android:id="@+id/view_builder_base"
            style="@style/WidgetViewButton"
            android:layout_marginStart="6dp"
            android:text="@string/view_builder_base" />

        <TextView
            android:id="@+id/view_all"
            style="@style/WidgetViewButton"
            android:layout_marginStart="6dp"
            android:text="@string/view_all" />
    </LinearLayout>

    <TextView
        android:id="@+id/empty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="@string/empty_state"
        android:textColor="@color/text_dim"
        android:textSize="14sp" />

    <!-- Timeline's top card: the next to finish, ticking. It sits outside the list, so it ticks on
         every phone. -->
    <LinearLayout
        android:id="@+id/hero"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:background="@drawable/wcard_classic"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="10dp"
        android:visibility="gone">

        <ImageView
            android:id="@+id/hero_icon"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:importantForAccessibility="no"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_placeholder" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/hero_label"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-black"
                android:maxLines="1"
                android:textColor="@color/text_dim"
                android:textSize="11sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/hero_name"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:fontFamily="sans-serif-medium"
                    android:maxLines="1"
                    android:textColor="@color/text"
                    android:textSize="14sp" />

                <ImageView
                    android:layout_width="15dp"
                    android:layout_height="15dp"
                    android:layout_marginStart="6dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_clock" />

                <TextView
                    android:id="@+id/hero_days"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:fontFamily="sans-serif-black"
                    android:textColor="@color/text"
                    android:textSize="20sp"
                    android:visibility="gone" />

                <Chronometer
                    android:id="@+id/hero_timer"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:fontFamily="sans-serif-black"
                    android:textColor="@color/text"
                    android:textSize="20sp" />
            </LinearLayout>

            <ProgressBar
                android:id="@+id/hero_bar"
                style="@android:style/Widget.ProgressBar.Horizontal"
                android:layout_width="match_parent"
                android:layout_height="5dp"
                android:layout_marginTop="4dp"
                android:indeterminate="false"
                android:max="1000"
                android:maxHeight="5dp"
                android:minHeight="5dp"
                android:progressDrawable="@drawable/wbar" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/rows"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical" />

    <ListView
        android:id="@+id/timeline_list"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="4dp"
        android:layout_weight="1"
        android:divider="@null"
        android:scrollbars="none"
        android:visibility="gone" />

    <!-- Running potions and snacks, for the styles that have no section headers to put them on. -->
    <LinearLayout
        android:id="@+id/boosts"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:orientation="horizontal"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/helpers"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:orientation="horizontal"
        android:visibility="gone">

        <Chronometer
            android:id="@+id/helpers_timer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/helper"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/helpers_ready"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-black"
            android:text="@string/helpers_ready"
            android:textColor="@color/helper"
            android:textSize="11sp"
            android:visibility="gone" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/update"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/text_dim"
            android:textSize="11sp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/all_upgrades"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:fontFamily="sans-serif-black"
            android:maxLines="1"
            android:paddingTop="2dp"
            android:paddingBottom="2dp"
            android:text="@string/widget_all_upgrades"
            android:textColor="@color/gold"
            android:textSize="12sp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/clear"
            style="@style/WidgetViewButton"
            android:layout_marginEnd="8dp"
            android:textColor="@color/gold"
            android:visibility="gone" />

        <TextView
            android:id="@+id/footer"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="end"
            android:textColor="@color/text_dim"
            android:textSize="11sp"
            android:visibility="gone" />

        <!-- Pages' arrows. -->
        <LinearLayout
            android:id="@+id/pager"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:visibility="gone">

            <ImageView
                android:id="@+id/page_up"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:background="@drawable/chip_view"
                android:contentDescription="@string/widget_page_up"
                android:padding="7dp"
                android:src="@drawable/ic_page_up" />

            <TextView
                android:id="@+id/page_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-black"
                android:gravity="center"
                android:minWidth="36dp"
                android:textColor="@color/text"
                android:textSize="12sp" />

            <ImageView
                android:id="@+id/page_down"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:background="@drawable/chip_view"
                android:contentDescription="@string/widget_page_down"
                android:padding="7dp"
                android:src="@drawable/ic_page_down" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
