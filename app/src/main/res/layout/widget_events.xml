<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/events_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:orientation="vertical"
    android:padding="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:fontFamily="sans-serif-black"
            android:letterSpacing="0.08"
            android:maxLines="1"
            android:shadowColor="@color/text_shadow"
            android:shadowDy="2"
            android:shadowRadius="1"
            android:text="@string/events_widget_title"
            android:textAllCaps="true"
            android:textColor="@color/gold"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/events_edit"
            style="@style/WidgetViewButton"
            android:layout_marginStart="6dp"
            android:text="@string/events_widget_edit"
            android:textColor="@color/gold" />
    </LinearLayout>

    <TextView
        android:id="@+id/events_empty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="@string/events_widget_description"
        android:textColor="@color/text_dim"
        android:textSize="14sp" />

    <!-- Rows that don't fit are cut off at the bottom, as on the big widget. -->
    <LinearLayout
        android:id="@+id/event_rows"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:layout_weight="1"
        android:orientation="vertical" />

    <TextView
        android:id="@+id/events_reset"
        style="@style/WidgetViewButton"
        android:layout_marginTop="2dp"
        android:textColor="@color/gold"
        android:visibility="gone" />
</LinearLayout>
