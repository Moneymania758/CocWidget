<?xml version="1.0" encoding="utf-8"?>
<!-- Every account shows with no setup, so the theme question is optional when it's placed. -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:configure="com.cocwidget.AccountsWidgetConfigActivity"
    android:description="@string/accounts_widget_description"
    android:initialLayout="@layout/widget_accounts"
    android:minWidth="250dp"
    android:minHeight="110dp"
    android:minResizeWidth="180dp"
    android:minResizeHeight="70dp"
    android:previewLayout="@layout/widget_accounts"
    android:resizeMode="horizontal|vertical"
    android:targetCellWidth="4"
    android:targetCellHeight="2"
    android:updatePeriodMillis="1800000"
    android:widgetCategory="home_screen"
    android:widgetFeatures="reconfigurable|configuration_optional" />
