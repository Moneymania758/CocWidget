<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- The app's screens draw their own header in the chosen skin, so no action bar. -->
    <style name="AppTheme" parent="@android:style/Theme.DeviceDefault.DayNight">
        <item name="android:windowActionBar">false</item>
        <item name="android:windowNoTitle">true</item>
    </style>
    <style name="Translucent" parent="@android:style/Theme.Translucent.NoTitleBar" />

    <!-- Home, Builder Base and All on the widget. The renderer lights the one in use. -->
    <style name="WidgetViewButton">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:background">@drawable/chip_view</item>
        <item name="android:fontFamily">sans-serif-black</item>
        <item name="android:maxLines">1</item>
        <item name="android:paddingStart">9dp</item>
        <item name="android:paddingTop">3dp</item>
        <item name="android:paddingEnd">9dp</item>
        <item name="android:paddingBottom">3dp</item>
        <item name="android:textColor">@color/text_dim</item>
        <item name="android:textSize">11sp</item>
    </style>

    <!-- "1 builder idle", "Lab idle" and the like under the widget's header. -->
    <style name="WidgetChip" parent="WidgetViewButton">
        <item name="android:visibility">gone</item>
    </style>
</resources>
